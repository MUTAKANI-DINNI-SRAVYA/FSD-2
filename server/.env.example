# Server Port
PORT=5000

# MongoDB Connection String (Atlas URI or local MongoDB daemon)
# Example Local: mongodb://127.0.0.1:27017/secondhand_marketplace
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/secondhand_marketplace?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/secondhand_marketplace

# JWT Secret for User Authentication Tokens
# In production, replace this with a strong, random 32+ character secret
JWT_SECRET=your_super_secret_jwt_key_here
